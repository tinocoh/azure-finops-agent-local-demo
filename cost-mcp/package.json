{
  "name": "azure-cost-mcp",
  "version": "0.1.0",
  "description": "MCP server for Azure cost analysis — retail prices and cost management",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "azure-cost-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "smoke": "node scripts/mcp-smoke.mjs",
    "e2e": "node scripts/mcp-e2e.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "lint:fix": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md,js}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md,js}\"",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "hono": "4.12.32",
    "@hono/node-server": "2.0.12",
    "fast-uri": "4.1.1",
    "esbuild": "0.28.1",
    "minimatch": "10.0.1"
  }
}
