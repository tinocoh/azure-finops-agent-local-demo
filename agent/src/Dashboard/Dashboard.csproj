<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AzureFinOps.Dashboard</RootNamespace>
    <UserSecretsId>azure-finops-agent-dashboard</UserSecretsId>
    <FrontendRoot>$(MSBuildProjectDirectory)\webui\</FrontendRoot>
    <FrontendOutput>$(MSBuildProjectDirectory)\wwwroot\</FrontendOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.0-beta.4" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.18.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.18.0" />
    <PackageReference Include="OpenTelemetry" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
  </ItemGroup>

  <!-- Embed Python script templates as resources (loaded at runtime by tools) -->
  <ItemGroup>
    <EmbeddedResource Include="AI\Tools\Resources\*.py" />
  </ItemGroup>

  <ItemGroup>
    <DashboardFrontendSource Include="webui\index.html;webui\vite.config.js;webui\src\**\*;webui\public\**\*" />
  </ItemGroup>

  <Target Name="BuildDashboardFrontend"
          BeforeTargets="Build;ComputeFilesToPublish"
          Inputs="webui\package.json;webui\package-lock.json;@(DashboardFrontendSource)"
          Outputs="$(FrontendOutput)index.html">
    <Message Importance="high" Text="Building Dashboard frontend assets..." />
    <Exec WorkingDirectory="$(FrontendRoot)" Command="npm ci --no-audit --no-fund" />
    <Exec WorkingDirectory="$(FrontendRoot)" Command="npm run build" />
  </Target>

</Project>
